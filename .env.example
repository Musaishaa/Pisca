# none = retrieval-only dari dataset + memory (jalan tanpa model, cocok untuk Render free tier)
# ollama = pakai Ollama lokal. Ganti ke ollama lalu isi LLM_MODEL/LLM_BASE_URL bila ingin jawaban generatif.
LLM_PROVIDER=none
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
DATABASE_URL=sqlite:///data/pisca.db
